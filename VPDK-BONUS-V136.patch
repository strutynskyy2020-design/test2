+.diamond-feed-aurora {
+  position: absolute;
+  inset: -45% -20%;
+  pointer-events: none;
+  opacity: .55;
+  background: conic-gradient(from 0deg, transparent 0 18%, rgba(125,211,252,.20) 26%, transparent 36% 58%, rgba(192,132,252,.18) 68%, transparent 78% 100%);
+  animation: diamond-feed-orbit 8s linear infinite;
+}
+.diamond-feed-card::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: linear-gradient(115deg, transparent 0 34%, rgba(255,255,255,.10) 46%, transparent 58% 100%);
+  transform: translateX(-120%);
+  animation: diamond-feed-shine 4.8s ease-in-out infinite;
+}
+@keyframes diamond-feed-orbit { to { transform: rotate(360deg); } }
+@keyframes diamond-feed-shine {
+  0%, 58% { transform: translateX(-120%); }
+  78%, 100% { transform: translateX(120%); }
+}
+@media (prefers-reduced-motion: reduce) {
+  .diamond-feed-aurora,
+  .diamond-feed-card::after { animation: none; }
+}
