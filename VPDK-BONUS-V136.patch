+.diamond-feed-card {
+  border-color: rgba(125, 211, 252, .72);
+  background:
+    radial-gradient(circle at 12% 0%, rgba(125, 211, 252, .20), transparent 42%),
+    radial-gradient(circle at 92% 100%, rgba(168, 85, 247, .16), transparent 46%),
