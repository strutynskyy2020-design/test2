+
+/* v137: a rectangular crystal frame follows every employee who currently wears a diamond avatar. */
+.diamond-card-auto {
+  position: relative;
+  isolation: isolate;
+}
+
+@supports selector(.diamond-card-auto:has(.avatar-frame--diamond)) {
+  .diamond-card-auto:has(.avatar-frame--diamond) {
+    border-color: rgba(126, 211, 255, .38) !important;
+    box-shadow:
+      0 0 0 1px rgba(218, 197, 255, .07) inset,
+      0 0 24px rgba(68, 190, 255, .13),
+      0 14px 34px rgba(0, 0, 0, .26);
+  }
+
+  .diamond-card-auto:has(.avatar-frame--diamond)::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: 40;
+    display: block;
+    border-radius: inherit;
+    pointer-events: none;
+    user-select: none;
+    background: url("/card-frames/diamond-employee-card-v137.png") center / 100% 100% no-repeat;
+    filter:
+      drop-shadow(0 0 4px rgba(92, 205, 255, .50))
+      drop-shadow(0 0 11px rgba(181, 126, 255, .22));
+    transform: translateZ(0);
+    animation: diamond-card-frame-breathe 3.8s ease-in-out infinite;
+  }
+}
+
+@keyframes diamond-card-frame-breathe {
+  0%, 100% {
+    opacity: .91;
+    filter:
+      drop-shadow(0 0 4px rgba(92, 205, 255, .44))
+      drop-shadow(0 0 9px rgba(181, 126, 255, .18));
+  }
+  50% {
+    opacity: 1;
+    filter:
+      drop-shadow(0 0 7px rgba(123, 222, 255, .68))
+      drop-shadow(0 0 15px rgba(201, 144, 255, .35));
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .diamond-card-auto:has(.avatar-frame--diamond)::before {
+    animation: none;
+  }
+}
+
+html.light .diamond-card-auto:has(.avatar-frame--diamond) {
+  box-shadow:
+    0 0 0 1px rgba(39, 139, 180, .10) inset,
+    0 10px 28px rgba(74, 93, 145, .12) !important;
+}
