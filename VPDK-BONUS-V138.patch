+  border-color: rgba(2,132,199,.38) !important;
+  box-shadow: 0 18px 46px rgba(44,82,130,.11) !important;
+}
+html.light .diamond-challenge-card .text-\[\#BAE6FD\] { color: #075985 !important; }
+html.light .diamond-challenge-card .bg-black\/25 {
+  background-color: rgba(255,255,255,.78) !important;
+  border-color: rgba(80,60,120,.12) !important;
+}
+
+/* Team Bank hero. Keep the premium lavender identity but use a light surface
+   and deep text colours instead of a dark panel with dark remapped labels. */
+html.light .team-bank-hero-card {
+  background:
+    radial-gradient(circle at top left, rgba(139,92,246,.13), transparent 46%),
+    linear-gradient(180deg, #FAF7FF, #F3F0F8) !important;
+  border-color: rgba(109,61,245,.24) !important;
+  box-shadow: 0 16px 38px rgba(70,53,108,.10) !important;
+}
+html.light .team-bank-hero-card .bg-black\/25 {
+  background-color: rgba(255,255,255,.76) !important;
+  border-color: rgba(80,60,120,.13) !important;
+}
+html.light .team-bank-hero-card .text-\[\#E9D8FF\] { color: #5B21B6 !important; }
+html.light .team-bank-hero-card .bg-\[\#B78CFF\]\/10 {
+  background-color: rgba(109,61,245,.09) !important;
+}
+
+/* Diamond-avatar controls inside the admin user sheet. */
+html.light .admin-diamond-avatar-panel {
+  background:
+    radial-gradient(circle at top, rgba(96,165,250,.13), transparent 58%),
+    #F7FAFF !important;
+  border-color: rgba(37,99,235,.24) !important;
+}
+
+/* Native select menus use browser-owned popups. Explicit colours prevent the
+   white-on-white/blank option list seen in Chrome on the admin overview. */
+.admin-team-filter-select {
+  color-scheme: dark;
+}
+.admin-team-filter-select option {
+  color: #F5F5F5;
+  background: #121318;
+}
+html.light .admin-team-filter-select {
+  color-scheme: light;
+  color: #20242E !important;
+  background: #FFFFFF !important;
+  border-color: #CFC9DA !important;
+  box-shadow: inset 0 1px 2px rgba(44,44,60,.04);
+}
+html.light .admin-team-filter-select option {
+  color: #20242E !important;
+  background: #FFFFFF !important;
+}
+
+/* Final safety net for the three semantic premium surfaces. It only scopes to
+   their own content and therefore does not alter saturated buttons globally. */
+html.light .diamond-challenge-card .text-white,
+html.light .team-bank-hero-card .text-white,
+html.light .admin-diamond-avatar-panel .text-white {
+  color: var(--light-text-strong) !important;
+}
+html.light .diamond-challenge-card .text-zinc-300,
+html.light .diamond-challenge-card .text-zinc-400,
+html.light .team-bank-hero-card .text-zinc-300,
+html.light .team-bank-hero-card .text-zinc-400,
+html.light .admin-diamond-avatar-panel .text-zinc-300,
+html.light .admin-diamond-avatar-panel .text-zinc-400 {
+  color: var(--light-text-body) !important;
+}
+html.light .diamond-challenge-card .text-zinc-500,
+html.light .team-bank-hero-card .text-zinc-500,
+html.light .admin-diamond-avatar-panel .text-zinc-500 {
+  color: var(--light-text-muted) !important;
+}
+
+/* Pale accent labels need deeper ink on white surfaces. */
+html.light .app-theme-shell:not(.game-only-app-shell) [class*="text-[#7DD3FC]"],
+html.light .app-theme-shell:not(.game-only-app-shell) [class*="text-[#BAE6FD]"] {
